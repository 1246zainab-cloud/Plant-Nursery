# Database: SQLite (file-based, no external server required)
# The app uses nursery.db in the project root by default.
DATABASE_URL=sqlite:///nursery.db

# Secret key for session signing and security (use a long random string in production)
SECRET_KEY=change-this-to-a-long-random-secret-key

# Optional: default admin credentials created on first run
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@nursery.com
ADMIN_PASSWORD=admin123
